node_modules/
.DS_Store
*.log

# Diagnostic output from `npm test` - regenerated on every run, and CI
# uploads it as a build artifact. dist/ is deliberately NOT ignored: it is
# the file people actually open.
tests/shots/

# dist/site is assembled on every build from dist/velthiros.html plus the
# committed icons and manifest, and the Pages workflow rebuilds it before
# deploying, so there is nothing here worth tracking.
dist/site/

# The itch.io upload is a zip of dist/site, which is itself generated. Build it
# with `npm run itch` rather than tracking 750 KB of derived bytes.
dist/*.zip
